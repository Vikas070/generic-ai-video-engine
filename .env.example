# Copy to .env (repo root) and fill in what you use.

# ElevenLabs — required for voice (tools/gen_voice.py); also powers
# sound-effect generation (tools/gen_sfx.py) and music beds (tools/gen_music.py).
ELEVENLABS_API_KEY=

# Google Gemini — image generation (tools/gen_image.py), e.g. story frames; also powers
# official Veo video generation (tools/gen_veo.py) — same key, no separate signup.
GEMINI_API_KEY=

# fal.ai — optional, generative video clips (tools/gen_clip.py, tools/bakeoff_clip.py).
FAL_KEY=

# No key needed for tools/ingest_flow_asset.py (manually-exported Google Flow clips) —
# see ai-shorts/PROVIDERS.md for how the three AI-video providers compare.
