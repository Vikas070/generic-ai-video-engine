# secrets
.env

# dependencies / build output
node_modules/
remotion/out/
__pycache__/
*.pyc
venv/

# heavy regenerable per-short artifacts:
# voice/ = cached ElevenLabs TTS lines, output/ = rendered videos.
# Both are rebuilt by the pipeline; finals are linked from the README instead.
shorts/*/voice/
shorts/*/output/
ai-shorts/*/voice/
ai-shorts/*/output/
vox-shorts/*/voice/
vox-shorts/*/output/
videos/*/voice/
videos/*/output/

# generated media binaries: images/video/audio produced by the pipeline
# (AI clips, rendered frames, voice lines, sfx/music). Kept out of git so only
# the authoring files (*.json, *.md — script, beats, character/DESIGN docs,
# sidecars) are versioned; the pixels/audio themselves live on local disk only.
# NOTE: this includes locked character/vox-layer reference images — a fresh
# clone will NOT have them, so a locked subject can't be reproduced from the
# text alone (back those up yourself if you want to keep reusing them).
shorts/**/*.png
shorts/**/*.jpg
shorts/**/*.jpeg
shorts/**/*.webp
shorts/**/*.gif
shorts/**/*.mp4
shorts/**/*.mov
shorts/**/*.mp3
shorts/**/*.wav
ai-shorts/**/*.png
ai-shorts/**/*.jpg
ai-shorts/**/*.jpeg
ai-shorts/**/*.webp
ai-shorts/**/*.gif
ai-shorts/**/*.mp4
ai-shorts/**/*.mov
ai-shorts/**/*.mp3
ai-shorts/**/*.wav
