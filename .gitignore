vox-shorts/**/*.jpg
vox-shorts/**/*.jpeg
vox-shorts/**/*.webp
vox-shorts/**/*.gif
vox-shorts/**/*.mp4
vox-shorts/**/*.mov
vox-shorts/**/*.mp3
vox-shorts/**/*.wav
videos/**/*.png
videos/**/*.jpg
videos/**/*.jpeg
videos/**/*.webp
videos/**/*.gif
videos/**/*.mp4
videos/**/*.mov
videos/**/*.mp3
videos/**/*.wav
